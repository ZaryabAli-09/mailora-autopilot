PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Optional in production when client and API use subdomains of one parent domain.
COOKIE_DOMAIN=
MONGO_URI=mongodb://127.0.0.1:27017/mailora_autopilot
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
JWT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Nebius Token Factory. Store the real key only in apps/api/.env.
NEBIUS_API_KEY=
# Run npm run models and copy exact model IDs from the authenticated response.
NEBIUS_MODEL_CLASSIFY=
NEBIUS_MODEL_CHAT=
NEBIUS_MODEL_PLANNER=
NEBIUS_MODEL_CLASSIFY_FALLBACK=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
